# 0/1 Knapsack Problem using Dynamic Programming

import time

# Taking input from the user
n = int(input("Enter the number of items: "))

weights = []
values = []

for i in range(n):
    w = int(input(f"Enter weight of item {i + 1}: "))
    v = int(input(f"Enter value of item {i + 1}: "))
    weights.append(w)
    values.append(v)

capacity = int(input("Enter the maximum capacity of the knapsack: "))

# Start execution time
start_time = time.perf_counter()

# DP table
dp = [[0 for _ in range(capacity + 1)] for _ in range(n + 1)]

# Dynamic Programming
for i in range(1, n + 1):
    for w in range(1, capacity + 1):

        if weights[i - 1] <= w:
            dp[i][w] = max(
                values[i - 1] + dp[i - 1][w - weights[i - 1]],
                dp[i - 1][w]
            )
        else:
            dp[i][w] = dp[i - 1][w]

# Maximum value
max_value = dp[n][capacity]

# End execution time
end_time = time.perf_counter()

# Display result
print("\nMaximum value that can be obtained:", max_value)
print("Execution Time:", end_time - start_time, "seconds")

# Time Complexity
print("\nTime Complexity: O(n * W)")
print("Space Complexity: O(n * W)")
