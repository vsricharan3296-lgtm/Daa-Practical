
import time

def floyd_warshall(graph, n):
    dist = [row[:] for row in graph]

    for k in range(n):
        for i in range(n):
            for j in range(n):
                dist[i][j] = min(dist[i][j],
                                 dist[i][k] + dist[k][j])

    return dist


n = int(input("Enter number of vertices: "))

print("Enter the adjacency matrix:")
print("Enter 99999 if there is no direct edge.")

graph = []
for i in range(n):
    row = list(map(int, input().split()))
    graph.append(row)

start = time.perf_counter()

result = floyd_warshall(graph, n)

end = time.perf_counter()

print("\nShortest Distance Matrix:")
for row in result:
    print(row)

print("\nExecution Time:", end - start, "seconds")

print("\nTime Complexity: O(n^3)")
print("Space Complexity: O(n^2)")
